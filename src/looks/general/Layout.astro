---
import BaseHead from '../../shared/BaseHead.astro';
import SiteNav from './components/SiteNav.astro';
import SiteFooter from './components/SiteFooter.astro';
import { brand } from '../../brand';

const { title, description = brand.blurb, active = '', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <SiteNav active={active} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <div class="built-by"><a href="https://stillwaterswebdesign.com" target="_blank" rel="noopener">Built by Still Waters Web Design</a></div>
  </body>
</html>

<style is:global>
  :root {
    --white: #ffffff;
    --silver: #d4d4d6; /* the grey behind the company logo */
    --radius: 6px;
    --line: #cfd3da;
    --shadow: 0 14px 34px -14px rgba(10, 22, 48, 0.28);
    --section-pad: clamp(3.25rem, 7vw, 5.5rem) 1rem;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.65; color: var(--body); background: var(--bg); }
  /* height:auto is what an image without a height attribute always had; the photos now carry width/height attributes (so the browser can reserve their space), and this keeps the CSS in charge of their size */
  img { max-width: 100%; display: block; height: auto; }
  a { color: inherit; }
  h1, h2, h3, h4 { font-family: var(--font-head); color: var(--ink); line-height: 1.15; margin: 0 0 0.5em; }
  p { margin: 0 0 1em; }
  ul { margin: 0; padding: 0; list-style: none; }

  .container { max-width: 76rem; width: 100%; margin: 0 auto; }
  .section { padding: var(--section-pad); }
  .section--sand { background: var(--sand); }
  .section--white { background: var(--white); }
  .section--dark { background: var(--primary); color: #cfd6e4; }
  .section--dark h2, .section--dark h3 { color: #fff; }

  /* small caps label above a heading, with a short rule: burgundy on light, gold on dark */
  .topper { display: flex; align-items: center; gap: 0.7rem; font-family: var(--font-head); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.7rem; }
  .topper::before { content: ''; width: 2rem; height: 3px; background: var(--cta); }
  .section--dark .topper, .hero .topper, .pagehead .topper { color: var(--cta-on-dark); }
  .title { font-size: clamp(1.55rem, 3.2vw, 2.3rem); font-weight: 800; letter-spacing: 0.02em; text-transform: uppercase; }
  .lead { font-size: 1.2rem; max-width: 42rem; }
  .section-head { max-width: 46rem; margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 3.1rem; padding: 0 1.7rem; border-radius: var(--radius); font-family: var(--font-head); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border: 2px solid transparent; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s, background-color 0.15s; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -8px rgba(10, 22, 48, 0.4); }
  .btn:focus-visible, a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .btn--cta { background: var(--cta); color: var(--on-cta); }
  .btn--primary { background: var(--primary); color: #fff; }
  .btn--outline { background: transparent; color: var(--primary); border-color: var(--primary); }
  .btn--outline-light { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.7); }

  .built-by { background: var(--primary); color: #aab5ca; font-size: 0.8125rem; text-align: center; padding: 0.55rem 1rem; }
  .built-by a { color: inherit; text-decoration: none; }
  .built-by a:hover { color: #fff; text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .btn { transition: none; } }
</style>
