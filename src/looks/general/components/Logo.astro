---
// The company logo as a lockup: the roof mark (photo bank `logo`, no. 2) beside the two name lines (no. 3), both cut from the full
// logo (no. 1). On a dark background (`light`) it sits on a white tile so the lettering stays readable. Without the pictures the
// name shows in type instead.
import { brand } from '../../../brand';
import { maybeImg } from '../../../assets';
const { light = false } = Astro.props;
const mark = maybeImg(['logo', 2]);
const name = maybeImg(['logo', 3]);
---

{mark && name ? (
  <span class:list={['logo', 'logo--pic', { 'logo--light': light }]} role="img" aria-label={brand.name}>
    <img class="mark" src={mark} alt="" width="84" height="44" />
    <img class="nm" src={name} alt="" width="210" height="44" />
  </span>
) : (
  <span class:list={['logo', { 'logo--light': light }]}>
    <span class="words">
      <strong class="word">{brand.shortName}</strong>
      <small class="sub">{brand.logoSub}</small>
    </span>
  </span>
)}

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .mark, .nm { height: 2.9rem; width: auto; display: block; }
  .logo--pic { gap: 0.55rem; }
  .logo--pic.logo--light { background: #fff; padding: 0.55rem 0.8rem; border-radius: var(--radius); }
  .words { display: flex; flex-direction: column; line-height: 1; }
  .word { font-family: var(--font-head); font-size: 1.35rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary); white-space: nowrap; }
  .sub { font-family: var(--font-head); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-top: 0.3rem; white-space: nowrap; }
  .logo--light .word { color: #fff; }
  .logo--light .sub { color: var(--cta-on-dark); }
  @media (max-width: 26rem) { .mark, .nm { height: 2.2rem; } .logo--pic { gap: 0.4rem; } .word { font-size: 1.05rem; letter-spacing: 0.06em; } .sub { font-size: 0.56rem; letter-spacing: 0.12em; } }
</style>
