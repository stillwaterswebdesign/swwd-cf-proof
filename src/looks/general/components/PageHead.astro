---
// The band at the top of an inner page: a short label, the page title and an optional line of text.
const { title, crumb = '', text = '' } = Astro.props;
---

<section class="pagehead">
  <div class="container">
    {crumb && <span class="topper">{crumb}</span>}
    <h1>{title}</h1>
    {text && <p>{text}</p>}
  </div>
</section>

<style>
  .pagehead { background: var(--primary); color: #cfd6e4; padding: clamp(2.5rem, 6vw, 4.25rem) 1rem; border-bottom: 5px solid var(--cta-on-dark); }
  h1 { color: #fff; font-size: clamp(1.9rem, 4.4vw, 3rem); font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; margin-bottom: 0.4rem; }
  p { max-width: 44rem; font-size: 1.2rem; margin: 0.5rem 0 0; }
</style>
