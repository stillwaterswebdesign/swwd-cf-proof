# Security headers on every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Built assets are fingerprinted, so they can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons change rarely.
/*.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# The thank-you page is not for search results.
/thanks/*
  X-Robots-Tag: noindex

# The web app manifest has its own content type.
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# proof run only: keep this copy of a real client site out of search results
/*
  X-Robots-Tag: noindex, nofollow
